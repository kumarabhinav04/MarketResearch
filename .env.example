AIFACTORY_ENV=development
AIFACTORY_DB_PATH=artifacts/aifactory.db
AIFACTORY_CONFIG_DIR=config
AIFACTORY_REPORT_DIR=artifacts/reports
AIFACTORY_RAW_SOURCE_DIR=artifacts/raw-sources
AIFACTORY_API_KEY=change-me
AIFACTORY_LOG_LEVEL=INFO
AIFACTORY_MAX_WORKERS=4
AIFACTORY_MIN_EVIDENCE_CONFIDENCE=0.65
AIFACTORY_MODEL_PROVIDER=offline
AIFACTORY_MODEL_NAME=
AIFACTORY_MODEL_BASE_URL=http://localhost:11434
AIFACTORY_MODEL_API_KEY=
AIFACTORY_MODEL_TIMEOUT_SECONDS=120
AIFACTORY_MODEL_MAX_COMPLETION_TOKENS=800
AIFACTORY_MODEL_REASONING_EFFORT=
AIFACTORY_OTEL_ENDPOINT=
AIFACTORY_SEC_USER_AGENT=AI-Factory-Research research@example.com

# Optional source credentials. Values belong in `.env` or a deployment secret store.
OPENFIGI_API_KEY=
COMPANIES_HOUSE_API_KEY=
EDINET_API_KEY=
EIA_API_KEY=
PATENTSVIEW_API_KEY=

# OpenRouter example (replace the three model settings above):
# AIFACTORY_MODEL_PROVIDER=openai_compatible
# AIFACTORY_MODEL_NAME=nvidia/nemotron-3.5-lightning:free
# AIFACTORY_MODEL_BASE_URL=https://openrouter.ai/api/v1
# AIFACTORY_MODEL_API_KEY=replace-with-a-secret-from-your-local-secret-store
# AIFACTORY_MODEL_MAX_COMPLETION_TOKENS=800
# AIFACTORY_MODEL_REASONING_EFFORT=none
