      "licence_notes": "Crown/public register data; observe Companies House API and document-service terms.",
      "auth": {"type": "basic_username", "env": "COMPANIES_HOUSE_API_KEY"},
      "endpoints": {},
      "options": {}
    },
    {
      "id": "filings_xbrl_org",
      "name": "filings.xbrl.org ESEF/UKSEF index",
      "category": "regulatory_filings",
      "connector": "filings_xbrl_org",
      "implementation_status": "planned",
      "enabled": false,
      "source_tier": "1",
      "publisher": "XBRL International",
      "base_url": "https://filings.xbrl.org",
      "rate_limit_per_second": 1.0,
      "timeout_seconds": 45,
      "max_response_bytes": 52428800,
      "licence_notes": "Free public API with change/withdrawal caveat; validate against national OAM records when material.",
      "auth": {"type": "none"},
      "endpoints": {"filings": "/api/filings", "entities": "/api/entities"},
      "options": {}
    },
    {
      "id": "edinet",
      "name": "Japan EDINET API v2",
      "category": "regulatory_filings",
      "connector": "edinet",
      "implementation_status": "planned",
      "enabled": false,
      "source_tier": "1",
      "publisher": "Financial Services Agency, Japan",
      "base_url": "https://api.edinet-fsa.go.jp",
      "rate_limit_per_second": 1.0,
      "timeout_seconds": 45,
      "max_response_bytes": 52428800,
      "licence_notes": "Official disclosure API; registration and API key are required.",
      "auth": {"type": "query", "name": "Subscription-Key", "env": "EDINET_API_KEY"},
      "endpoints": {},
      "options": {}
    },
    {
      "id": "eia",
      "name": "U.S. Energy Information Administration API v2",
      "category": "power_market",
      "connector": "eia",
      "implementation_status": "planned",
      "enabled": false,
      "source_tier": "1",
      "publisher": "U.S. Energy Information Administration",
      "base_url": "https://api.eia.gov",
      "rate_limit_per_second": 1.0,
      "timeout_seconds": 45,
      "max_response_bytes": 20971520,
      "licence_notes": "Public government energy data; a free API key is required.",
      "auth": {"type": "query", "name": "api_key", "env": "EIA_API_KEY"},
      "endpoints": {"electricity": "/v2/electricity"},
