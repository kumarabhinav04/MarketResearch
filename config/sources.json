    {
      "id": "patentsview",
      "name": "USPTO PatentsView PatentSearch",
      "category": "patents",
      "connector": "patentsview",
      "implementation_status": "planned",
      "enabled": false,
      "source_tier": "2",
      "publisher": "United States Patent and Trademark Office",
      "base_url": "https://search.patentsview.org",
      "rate_limit_per_second": 1.0,
      "timeout_seconds": 45,
      "max_response_bytes": 20971520,
      "licence_notes": "Public patent data; PatentSearch API key required. Patent counts alone are not moat evidence.",
      "auth": {"type": "header", "name": "X-Api-Key", "env": "PATENTSVIEW_API_KEY"},
      "endpoints": {"patents": "/api/v1/patent/"},
      "options": {}
