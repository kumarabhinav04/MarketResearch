{
  "version": "1.0.0",
  "sources": [
    {
      "id": "sec_edgar",
      "name": "SEC EDGAR",
      "category": "regulatory_filings",
      "connector": "sec_edgar",
      "implementation_status": "implemented",
      "enabled": true,
      "source_tier": "1",
      "publisher": "U.S. Securities and Exchange Commission",
      "base_url": "https://data.sec.gov",
      "rate_limit_per_second": 8.0,
      "timeout_seconds": 15,
      "max_response_bytes": 52428800,
      "licence_notes": "Public regulatory records; comply with SEC fair-access and declared User-Agent requirements.",
      "auth": {"type": "none"},
      "endpoints": {
        "universe": "https://www.sec.gov/files/company_tickers_exchange.json",
        "submissions": "/submissions/CIK{cik}.json",
        "company_facts": "/api/xbrl/companyfacts/CIK{cik}.json",
        "filing": "https://www.sec.gov/Archives/edgar/data/{cik_unpadded}/{accession_compact}/{primary_document}"
      },
      "options": {
        "forms": ["10-K", "10-Q", "8-K", "20-F", "40-F", "6-K"],
        "default_filing_limit": 3
      }
    },
    {
      "id": "gleif",
      "name": "Global LEI Index",
      "category": "entity_identity",
      "connector": "gleif",
      "implementation_status": "implemented",
      "enabled": true,
      "source_tier": "1",
      "publisher": "Global Legal Entity Identifier Foundation",
      "base_url": "https://api.gleif.org",
      "rate_limit_per_second": 2.0,
      "timeout_seconds": 30,
      "max_response_bytes": 10485760,
      "licence_notes": "Open LEI reference data; retain GLEIF attribution and source timestamp.",
      "auth": {"type": "none"},
      "endpoints": {
        "search": "/api/v1/lei-records",
        "fuzzy": "/api/v1/fuzzycompletions",
        "record": "/api/v1/lei-records/{lei}"
      },
      "options": {
        "minimum_name_similarity": 0.82,
        "result_limit": 10,
        "legal_suffixes": ["ag", "co", "company", "corp", "corporation", "inc", "incorporated", "limited", "ltd", "nv", "plc", "sa"]
      }
    },
    {
      "id": "gdelt",
      "name": "GDELT DOC 2.0",
      "category": "news_discovery",
      "connector": "gdelt",
      "implementation_status": "implemented",
      "enabled": true,
      "source_tier": "3",
      "publisher": "The GDELT Project",
      "base_url": "https://api.gdeltproject.org",
      "rate_limit_per_second": 0.5,
      "timeout_seconds": 15,
      "max_response_bytes": 10485760,
      "licence_notes": "Discovery metadata only. Original publisher terms govern article content; do not treat discovery results as primary evidence.",
      "auth": {"type": "none"},
      "endpoints": {"search": "/api/v2/doc/doc"},
      "options": {
        "topic_query": "(\"AI data center\" OR \"AI factory\" OR hyperscale OR \"liquid cooling\" OR switchgear OR \"800G\")",
        "default_result_limit": 25,
        "max_attempts": 2,
        "include_ticker": true,
        "legal_suffixes": ["ag", "co", "company", "corp", "corporation", "inc", "incorporated", "limited", "ltd", "nv", "plc", "sa"]
      }
    },
    {
      "id": "usaspending",
      "name": "USAspending.gov",
      "category": "government_awards",
      "connector": "usaspending",
      "implementation_status": "planned",
      "enabled": false,
      "source_tier": "1",
      "publisher": "U.S. Department of the Treasury",
      "base_url": "https://api.usaspending.gov",
      "rate_limit_per_second": 2.0,
      "timeout_seconds": 45,
      "max_response_bytes": 20971520,
      "licence_notes": "Public U.S. federal award data; recipient entity resolution must be reviewed before scoring.",
      "auth": {"type": "none"},
      "endpoints": {"award_search": "/api/v2/search/spending_by_award/"},
      "options": {}
    },
    {
      "id": "openfigi",
      "name": "OpenFIGI",
      "category": "security_identity",
      "connector": "openfigi",
      "implementation_status": "planned",
      "enabled": false,
      "source_tier": "2",
      "publisher": "Bloomberg OpenFIGI",
      "base_url": "https://api.openfigi.com",
      "rate_limit_per_second": 0.35,
      "timeout_seconds": 30,
      "max_response_bytes": 10485760,
      "licence_notes": "Review OpenFIGI terms and identifier redistribution requirements before production use.",
      "auth": {"type": "header", "name": "X-OPENFIGI-APIKEY", "env": "OPENFIGI_API_KEY", "optional": true},
      "endpoints": {"mapping": "/v3/mapping"},
      "options": {}
    },
    {
      "id": "companies_house",
      "name": "UK Companies House",
      "category": "regulatory_filings",
      "connector": "companies_house",
      "implementation_status": "planned",
      "enabled": false,
      "source_tier": "1",
      "publisher": "UK Companies House",
      "base_url": "https://api.company-information.service.gov.uk",
